# --- Feature flags ---
# Playwright only pre-fills and opens the ATS form for you to review/submit
# yourself until you explicitly flip this to true for a given ATS.
AUTO_SUBMIT_APPLICATIONS=false

# --- Database ---
# "sqlite" (default, local dev/offline) or "supabase"
DB_BACKEND=sqlite
SQLITE_PATH=database/job_agent.db
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# --- LLM (OpenRouter free-tier by default) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
HF_API_TOKEN=
HF_MODEL=

# --- Email (Gmail SMTP with App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Webhook exposure (ngrok free tier) ---
NGROK_AUTHTOKEN=
PUBLIC_BASE_URL=http://localhost:8000

# --- Approval token signing ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_SECONDS=259200

# --- Scraper etiquette ---
SCRAPER_MIN_DELAY_SECONDS=3
SCRAPER_USER_AGENT=job-agent/0.1 (personal use; contact: you@example.com)
