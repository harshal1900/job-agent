# --- Feature flags ---
# Playwright only pre-fills and opens the ATS form for you to review/submit
# yourself until you explicitly flip this to true for a given ATS.
AUTO_SUBMIT_APPLICATIONS=false

# --- Database ---
# "sqlite" (default, local dev/offline) or "supabase"
DB_BACKEND=sqlite
SQLITE_PATH=database/job_agent.db
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# --- LLM (Gemini free tier by default: ~1,000 req/day vs OpenRouter's 50/day) ---
# Must be an "-flash-lite" model for the good free quota — plain "-flash"
# models are capped at 20 req/day, worse than OpenRouter.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Kept as a fallback — set LLM_PROVIDER=openrouter to switch back, no code change needed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
HF_API_TOKEN=
HF_MODEL=

# --- Email (Resend API) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# --- Webhook exposure (ngrok free tier) ---
# Off by default — only flip on for an actual approval window (see
# api/tunnel.py). Requires `ngrok config add-authtoken <token>` to already
# be set up locally, unless you set NGROK_AUTHTOKEN below as a fallback.
ENABLE_NGROK_TUNNEL=false
APP_PORT=8000
NGROK_AUTHTOKEN=
PUBLIC_BASE_URL=http://localhost:8000

# --- Approval token signing ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_SECONDS=259200

# --- Matching ---
# Jobs scoring below this are scored but never tailored or emailed.
MATCH_SCORE_THRESHOLD=70

# --- Scraper etiquette ---
SCRAPER_MIN_DELAY_SECONDS=3
SCRAPER_USER_AGENT=job-agent/0.1 (personal use; contact: you@example.com)
